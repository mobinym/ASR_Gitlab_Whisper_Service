# Model Configuration
# Use HuggingFace model (will auto-download on first run)
DEFAULT_MODEL_NAME=203-final-ct2
# Or use your local model: 203-final (if it exists in MODELS_BASE_DIR)
# Available models: whisper-tiny, whisper-base, whisper-small, whisper-medium, whisper-large-v3

MODELS_BASE_DIR=D:/data/models

# Device Configuration
DEVICE=cpu
# Options: cuda, cpu

COMPUTE_TYPE=int8
# Options for CUDA: float16, int8_float16, int8
# Options for CPU: int8, float32

# Performance Configuration
MAX_WORKERS=2
# Number of worker threads for concurrent processing

BATCH_SIZE=4
# Batch size for batched inference (higher = more throughput, more memory)
# For CPU, use lower values: 4-8

# Transcription Settings
VAD_FILTER=true
# Enable Voice Activity Detection to filter out silence

BEAM_SIZE=5
# Beam size for decoding (1-10, higher = better quality but slower)

# Server Configuration
HOST=0.0.0.0
PORT=8000
