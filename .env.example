# Faster Whisper Service Configuration

# Model Configuration
DEFAULT_MODEL_NAME=openai/whisper-large-v3
# Can be a local path: /data/models/my-model
# Or HuggingFace model: openai/whisper-large-v3, openai/whisper-medium, etc.

MODELS_BASE_DIR=/data/models

# Device Configuration
DEVICE=cuda
# Options: cuda, cpu

COMPUTE_TYPE=float16
# Options for CUDA: float16, int8_float16, int8
# Options for CPU: int8, float32

# Performance Configuration
MAX_WORKERS=4
# Number of worker threads for concurrent processing

BATCH_SIZE=16
# Batch size for batched inference (higher = more throughput, more memory)

# Transcription Settings
VAD_FILTER=true
# Enable Voice Activity Detection to filter out silence

BEAM_SIZE=5
# Beam size for decoding (1-10, higher = better quality but slower)

# Server Configuration
HOST=0.0.0.0
PORT=8000
